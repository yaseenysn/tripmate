# TripMate Backend Environment Configuration

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tripmate?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Deployed Render Frontend URL for CORS Security (comma-separated for multiple origins)
# Development: http://localhost:3001
# Production: https://<your-frontend-render-name>.onrender.com
FRONTEND_URL=http://localhost:3001
