# TripMate Backend Environment Configuration

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tripmate?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Deployed Frontend Base URL for email invitation links & CORS security
# Development: http://localhost:3001
# Production (Vercel): https://your-tripmate-app.vercel.app
FRONTEND_URL=http://localhost:3001

# Cloudinary Configuration for Media & Asset Uploads
# (Required for group cover photos, avatars, and documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
